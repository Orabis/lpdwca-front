---
import BaseLayout from '@/layouts/BaseLayout.astro'
import PageHeader from '@/components/ui/PageHeader.astro'
import FormationTypeCard from '@/components/cards/FormationTypeCard.astro'
import InfoCard from '@/components/cards/InfoCard.astro'
import CtaBand from '@/components/ui/CtaBand.astro'
import { getPageContent } from '@/services/pages'

const c = (await getPageContent<any>('formation-page', {
  'populate[header]': true,
  'populate[seo]': true,
  'populate[cta]': true,
  'populate[types]': true,
  'populate[continuingCards][populate][items]': true,
  'populate[apprenticeshipCards][populate][items]': true,
})) as any

const formationTypes = c.types ?? []
const toCards = (cards: any[]) =>
  (cards ?? []).map((k: any) => ({ ...k, items: (k.items ?? []).map((i: any) => i.text) }))
const infoCards = toCards(c.continuingCards)
const apprenticeshipCards = toCards(c.apprenticeshipCards)
---

<BaseLayout
  title={c.seo?.metaTitle ?? 'Formation'}
  description={c.seo?.metaDescription}
  pageClass='page--formation'
>
  <PageHeader
    title={c.header.title}
    description={c.header.description}
    variant='formation'
    headingId='formation-title'
  />

  <section
    class='formation-types'
    aria-label='Types de formation'
  >
    <div class='formation-types__grid'>
      {
        formationTypes.map((item) => (
          <FormationTypeCard
            title={item.title}
            description={item.description}
            question={item.question}
            icon={item.icon}
          />
        ))
      }
    </div>
  </section>

  <section
    class='formation-section'
    aria-labelledby='formation-continue-title'
  >
    <div class='formation-section__header'>
      <h2
        class='formation-section__title'
        id='formation-continue-title'
      >
        {c.continuingTitle}
      </h2>
      <p class='formation-section__description'>{c.continuingDescription}</p>
    </div>

    <div class='info-cards-grid'>
      {
        infoCards.map((item) => (
          <InfoCard
            title={item.title}
            icon={item.icon}
            items={item.items}
            ordered={item.ordered}
          />
        ))
      }
    </div>
  </section>
  <section
    class='formation-section'
    id='formation-initiale'
    aria-labelledby='formation-initiale-title'
  >
    <div class='formation-section__header'>
      <h2
        class='formation-section__title'
        id='formation-initiale-title'
      >
        {c.apprenticeshipTitle}
      </h2>
      <p class='formation-section__description'>{c.apprenticeshipDescription}</p>
    </div>

    <div class='info-cards-grid'>
      {
        apprenticeshipCards.map((item: any) => (
          <InfoCard
            title={item.title}
            icon={item.icon}
            items={item.items}
            ordered={item.ordered}
          />
        ))
      }
    </div>

    <p class='candidature-section__note'>
      <strong>{c.companyBoxTitle}</strong> {c.companyBoxText} <a href={c.companyBoxCtaHref}>{c.companyBoxCtaLabel}</a>
    </p>
  </section>

  <CtaBand
    title={c.cta.title}
    text={c.cta.text}
    primaryLabel={c.cta.primaryLabel}
    primaryHref={c.cta.primaryHref}
    secondaryLabel={c.cta.secondaryLabel}
    secondaryHref={c.cta.secondaryHref}
    headingId='formation-cta-title'
  />
</BaseLayout>
