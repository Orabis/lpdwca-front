---
import BaseLayout from '@/layouts/BaseLayout.astro'
import PageHeader from '@/components/ui/PageHeader.astro'
import FormField from '@/components/ui/FormField.astro'
import Button from '@/components/ui/Button.astro'
import { getNavigation } from '@/services/navigation'
import { getUiLabels } from '@/services/ui-labels'
import { getPageContent } from '@/services/pages'

const c = (await getPageContent<any>('contact-page', {
  'populate[header]': true,
  'populate[seo]': true,
  'populate[fields][populate][options]': true,
  'populate[infoCards]': true,
})) as any

const labels = await getUiLabels()

const { socialLinks } = await getNavigation()

const infoCards = c.infoCards ?? []
const contactFields = (c.fields ?? []).map((f: any, i: number) => ({
  ...f,
  id: 'contact-' + f.name,
}))
---

<BaseLayout
  title={c.seo?.metaTitle ?? 'Contact'}
  description={c.seo?.metaDescription}
  pageClass='page--contact'
>
  <PageHeader
    title={c.header.title}
    description={c.header.description}
    variant='split'
    headingId='contact-title'
  />

  <section
    class='contact-section'
    aria-labelledby='contact-form-title'
  >
    <div class='contact-panel'>
      <div class='contact-panel__form'>
        <h2
          class='sr-only'
          id='contact-form-title'
          >{c.formTitle}</h2
        >

        <form class='contact-form'>
          <div class='contact-form__grid'>
            {
              contactFields.map((field) => (
                <FormField
                  id={field.id}
                  name={field.name}
                  label={field.label}
                  type={field.type}
                  placeholder={field.placeholder}
                  textarea={field.textarea}
                  full={field.full}
                />
              ))
            }
          </div>

          <div class='contact-form__actions'>
            <Button type='submit'>{c.submitLabel}</Button>
          </div>
        </form>
      </div>

      <aside
        class='contact-panel__aside'
        aria-label='Informations de contact'
      >
        {
          infoCards.map((item) => (
            <article class='contact-info-card'>
              <span
                class='contact-info-card__icon-box'
                aria-hidden='true'
              >
                <span class:list={['icon', `icon--${item.icon}`, 'contact-info-card__icon']} />
              </span>
              {item.href ? (
                <a
                  class='contact-info-card__text'
                  href={item.href}
                >
                  {item.label}
                </a>
              ) : (
                <p class='contact-info-card__text'>{item.label}</p>
              )}
            </article>
          ))
        }

        <article class='contact-info-card'>
          <div
            class='contact-info-card__social'
            aria-label='Profils sociaux'
          >
            {
              socialLinks.map((link) => (
                <a
                  class='contact-info-card__social-link'
                  href={link.href}
                  aria-label={link.label}
                >
                  <span
                    class:list={['icon', `icon--${link.icon}`]}
                    aria-hidden='true'
                  />
                </a>
              ))
            }
          </div>
          <p class='contact-info-card__text'>{c.socialLabel}</p>
        </article>

        <article class='contact-info-card'>
          <a
            class='contact-info-card__text'
            href={c.officialContactHref}
            target='_blank'
            rel='noopener noreferrer'
            >{c.officialContactLabel} <span class='sr-only'>{labels.externalLinkSuffix}</span></a
          >
        </article>
      </aside>
    </div>
  </section>
</BaseLayout>
