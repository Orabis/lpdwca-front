---
import BaseLayout from '@/layouts/BaseLayout.astro'
import ArticleCarousel from '@/components/ArticleCarousel.astro'
import HomeHero from '@/components/sections/HomeHero.astro'
import FaqAccordion from '@/components/sections/FaqAccordion.astro'
import SectionBase from '@/components/ui/SectionBase.astro'
import AdvantageCard from '@/components/cards/AdvantageCard.astro'
import CourseCard from '@/components/cards/CourseCard.astro'
import TestimonialCard from '@/components/cards/TestimonialCard.astro'
import { getHomeContent } from '@/services/home'
import { hasStrapiConfig } from '@/services/strapi'

const c = await getHomeContent()
---

<BaseLayout
  title='Licence Professionnelle Développement Web Communication et Apprentissages'
  pageClass='page--home'
>
  <HomeHero />

  <SectionBase
    id='avantages'
    sectionClass='section--advantages'
    title={c.advantagesHeader.title}
    intro={c.advantagesHeader.intro}
    actionLabel={c.advantagesHeader.actionLabel}
    actionHref={c.advantagesHeader.actionHref}
  >
    <div class='advantages__grid'>
      {
        c.advantages.map((item) => (
          <AdvantageCard
            number={item.number}
            title={item.title}
            description={item.description}
          />
        ))
      }
    </div>
  </SectionBase>

  {
    hasStrapiConfig && (
      <SectionBase
        id='carousel'
        sectionClass='section--carousel'
        title={c.articlesHeader.title}
        intro={c.articlesHeader.intro}
        actionLabel={c.articlesHeader.actionLabel}
        actionHref={c.articlesHeader.actionHref}
      >
        <ArticleCarousel limit={3} />
      </SectionBase>
    )
  }

  <SectionBase
    id='programme'
    sectionClass='section--courses'
    title={c.coursesHeader.title}
    intro={c.coursesHeader.intro}
    actionLabel={c.coursesHeader.actionLabel}
    actionHref={c.coursesHeader.actionHref}
  >
    <div class='courses__grid'>
      {
        c.courses.map((item) => (
          <CourseCard
            title={item.title}
            description={item.description}
            imageSrc={item.imageSrc}
            imageAlt={item.imageAlt}
            href={item.href}
          />
        ))
      }
    </div>
  </SectionBase>

  <SectionBase
    id='temoignages'
    sectionClass='section--testimonials'
    title={c.testimonialsHeader.title}
    intro={c.testimonialsHeader.intro}
    actionLabel={c.testimonialsHeader.actionLabel}
    actionHref={c.testimonialsHeader.actionHref}
  >
    <div class='testimonials__grid'>
      {
        c.testimonials.map((item) => (
          <TestimonialCard
            name={item.name}
            quote={item.quote}
            href={item.href}
            avatarSrc={item.avatarSrc}
            avatarAlt={item.avatarAlt}
          />
        ))
      }
    </div>
  </SectionBase>

  <FaqAccordion
    id='faq'
    title={c.faqHeader.title}
    intro={c.faqHeader.intro}
    actionLabel={c.faqHeader.actionLabel}
    actionHref={c.faqHeader.actionHref}
    items={c.faqItems}
  />
</BaseLayout>
