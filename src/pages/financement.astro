---
import BaseLayout from '@/layouts/BaseLayout.astro'
import PageHeader from '@/components/ui/PageHeader.astro'
import FundingCard from '@/components/cards/FundingCard.astro'
import { getPageContent } from '@/services/pages'

const c = (await getPageContent<any>('financement-page', {
  'populate[header]': true,
  'populate[seo]': true,
  'populate[fundingColumns][populate][items]': true,
  'populate[extraOptions]': true,
  'populate[apprenticeshipColumns][populate][items]': true,
})) as any

const fundingColumns = (c.fundingColumns ?? []).map((col: any) => ({
  title: col.title,
  items: (col.items ?? []).map((i: any) => i.label),
}))
const extraOptions = (c.extraOptions ?? []).map((i: any) => i.label)
---

<BaseLayout
  title={c.seo?.metaTitle ?? 'Financement'}
  description={c.seo?.metaDescription}
  pageClass='page--financement'
>
  <PageHeader
    title={c.header.title}
    description={c.header.description}
    variant='split'
    headingId='financement-title'
  />

  <section
    class='financement-section'
    aria-labelledby='financement-options-title'
  >
    <div
      class='financement-switch'
      aria-label={c.switchAriaLabel}
    >
      <button
        class='financement-switch__button financement-switch__button--active'
        type='button'
        aria-pressed='true'
      >
        {c.switchContinuingLabel}
      </button>
      <button
        class='financement-switch__button'
        type='button'
        aria-pressed='false'
      >
        {c.switchApprenticeshipLabel}
      </button>
    </div>

    <p
      class='financement-section__intro'
      id='financement-options-title'
    >
      {c.continuingIntro}
    </p>

    <div class='financement-panel financement-panel--primary'>
      <div class='financement-grid'>
        {
          fundingColumns.map((column: { title: string; items: string[] }) => (
            <FundingCard
              title={column.title}
              items={column.items}
            />
          ))
        }
      </div>
    </div>

    <div class='financement-panel financement-panel--secondary'>
      <FundingCard
        title={c.extraTitle}
        items={extraOptions}
        wide
      />
    </div>
  </section>
</BaseLayout>

<script>
  import { initFinancementSwitch } from '../scripts/financement-switch'
  initFinancementSwitch()
</script>
