---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ProgramCard from "@/components/cards/ProgramCard.astro";
import CurriculumCard from "@/components/cards/CurriculumCard.astro";
import ScientificLeadCard from "@/components/cards/ScientificLeadCard.astro";
import LicencePanel from "@/components/cards/LicencePanel.astro";
import InsertionStatsCard from "@/components/cards/InsertionStatsCard.astro";
import PageHeader from "@/components/ui/PageHeader.astro";
import { getPageContent } from "@/services/pages";
import { getUiLabels } from "@/services/ui-labels";
import type { LicencePanelBlock } from "@/data/licence";
import ericPhoto from "@/assets/images/Eric.png";
import marcTrestiniPhoto from "@/assets/images/Marc_Trestini.jpg";
import type { ImageMetadata } from "astro";

const c = (await getPageContent<any>("licence-page", {
  "populate[header]": true,
  "populate[seo]": true,
  "populate[programDomains]": true,
  "populate[semesters][populate][ues][populate][lines]": true,
  "populate[leads][populate]": "photo",
  "populate[organisationPanels][populate][blocks][populate]": "*",
  "populate[afterPanels][populate][blocks][populate]": "*",
  "populate[insertion][populate][stats]": true,
})) as any

const labels = await getUiLabels();;

// Reconstitution des formes attendues par le gabarit existant.
const programDomains = c.programDomains ?? [];
const semesters = (c.semesters ?? []).map((s: any) => ({
  ...s,
  ues: (s.ues ?? []).map((u: any) => ({
    ...u,
    ue: u.code,
    lines: (u.lines ?? []).map((l: any) => l.text),
  })),
}));
const toPanel = (p: any) => ({
  blocks: (p.blocks ?? []).map((b: any): LicencePanelBlock => ({
    title: b.title,
    mobileTitle: b.mobileTitle ?? undefined,
    paragraphs: (b.paragraphs ?? []).map((x: any) => x.text),
    items: (b.items ?? []).map((x: any) => x.text),
  })),
});
const organisationPanels = (c.organisationPanels ?? []).map(toPanel);
const afterGraduationPanels = (c.afterPanels ?? []).map(toPanel);
const insertionStats = {
  title: c.insertion?.cardTitle ?? c.insertionTitle,
  intro: c.insertion?.intro ?? "",
  stats: (c.insertion?.stats ?? []).map((x: any) => x.text),
  href: c.insertion?.href,
  linkLabel: c.insertion?.linkLabel,
};
// Photos des responsables : encore servies par le depot front tant qu'elles
// ne sont pas televersees dans Strapi.
const LEAD_PHOTOS: Record<string, any> = {
  "Éric Christoffel": ericPhoto,
  "Marc Trestini": marcTrestiniPhoto,
};
const scientificLeads = (c.leads ?? []).map((l: any) => ({
  name: l.name,
  role: l.role,
  imageSrc: LEAD_PHOTOS[l.name] ?? ericPhoto,
  imageAlt: l.photoAlt,
  align: l.align ?? undefined,
}));
---

<BaseLayout
  title={c.seo?.metaTitle ?? "Licence"}
  description={c.seo?.metaDescription}
  pageClass="page--licence"
>
  <PageHeader
    title={c.header.title}
    description={c.header.description}
    variant='split'
    headingId='licence-title'
  />


  <section class="program" id="programme" aria-labelledby="program-title">
    <div class="program__inner">
      <header class="program__header">
        <h2 class="program__title" id="program-title">
          {c.programTitle}
        </h2>
        <p class="program__intro">{c.programIntro}</p>
      </header>
      <div class="program__cards">
        {
          programDomains.map((domain: { icon: string; title: string; description: string; href: string | undefined; }) => (
            <ProgramCard
              icon={domain.icon}
              title={domain.title}
              description={domain.description}
              href={domain.href}
            />
          ))
        }
      </div>
      <a class="program__cta" href={c.programCtaHref}>
        <span class="program__cta-text">{c.programCtaLabel}</span>
        <span
          class="icon icon--arrow-right program__cta-icon"
          aria-hidden="true"></span>
      </a>
    </div>
  </section>

  <section class="objectives" aria-labelledby="objectives-title">
    <div class="objectives__inner">
      <h2 class="objectives__title" id="objectives-title">{c.objectivesTitle}</h2>
      <p class="objectives__text" set:html={c.objectivesText} />
    </div>
  </section>

  <section class="curriculum" id="curriculum" aria-labelledby="curriculum-title">
    <div class="curriculum__inner">
      <h2 class="curriculum__title" id="curriculum-title">{c.curriculumTitle}</h2>

      {
        semesters.map((semester: { gridModifier: any; ariaLabel: string | null | undefined; ues: { ue: string; icon: string; title: string; lines: string[]; short: boolean | undefined; offset: "top" | "bottom" | undefined; }[]; label: unknown; }) => (
          <div class="curriculum__semester">
            <div
              class:list={[
                "curriculum__grid",
                `curriculum__grid--${semester.gridModifier}`,
              ]}
              role="list"
              aria-label={semester.ariaLabel}
            >
              {semester.ues.map((ue: { ue: string; icon: string; title: string; lines: string[]; short: boolean | undefined; offset: "top" | "bottom" | undefined; }) => (
                <CurriculumCard
                  ue={ue.ue}
                  icon={ue.icon}
                  title={ue.title}
                  lines={ue.lines}
                  short={ue.short}
                  offset={ue.offset}
                />
              ))}
            </div>
            <p class="curriculum__semester-label">{semester.label}</p>
          </div>
        ))
      }

      <p class="curriculum__links">
        <a
          class="curriculum__link"
          href={c.curriculumCtaHref}
          target="_blank"
          rel="noopener noreferrer"
          >{c.curriculumCtaLabel} <span class="sr-only">{labels.externalLinkSuffix}</span></a
        >
        <a
          class="curriculum__link"
          href={c.pdfHref}
          download
          >{c.pdfLabel}</a
        >
      </p>
    </div>
  </section>

  <section class="leads" aria-labelledby="leads-title">
    <div class="leads__inner">
      <h2 class="leads__title" id="leads-title">
        {c.leadsTitle}
      </h2>
      <div class="leads__grid">
        {
          scientificLeads.map((lead: { name: string; role: string; imageSrc: ImageMetadata; imageAlt: string; align: "right" |"left" | undefined; }) => (
            <ScientificLeadCard
              name={lead.name}
              role={lead.role}
              imageSrc={lead.imageSrc}
              imageAlt={lead.imageAlt}
              align={lead.align}
            />
          ))
        }
      </div>
    </div>
  </section>

  <section class="organisation" id="organisation" aria-labelledby="organisation-title">
    <div class="organisation__inner">
      <h2 class="organisation__title" id="organisation-title">{c.organisationTitle}</h2>
      <div class="licence-panels-grid">
        {
          organisationPanels.map((panel: { blocks: LicencePanelBlock[]; }) => (
            <LicencePanel blocks={panel.blocks} />
          ))
        }
      </div>
    </div>
  </section>

  <section class="after-graduation" aria-labelledby="after-graduation-title">
    <div class="after-graduation__inner">
      <h2 class="after-graduation__title" id="after-graduation-title">{c.afterTitle}</h2>
      <div class="licence-panels-grid">
        {
          afterGraduationPanels.map((panel: { blocks: LicencePanelBlock[]; }) => (
            <LicencePanel blocks={panel.blocks} />
          ))
        }
      </div>
    </div>
  </section>

  <section class="insertion" id="insertion" aria-labelledby="insertion-title">
    <div class="insertion__inner">
      <h2 class="insertion__title" id="insertion-title">{c.insertionTitle}</h2>
      <InsertionStatsCard
        title={insertionStats.title}
        intro={insertionStats.intro}
        stats={insertionStats.stats}
        href={insertionStats.href}
        linkLabel={insertionStats.linkLabel}
      />
    </div>
  </section>
</BaseLayout>
