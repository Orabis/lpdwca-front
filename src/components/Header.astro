---
// Le bandeau et la barre de navigation viennent du single type « Navigation »
// de Strapi. BaseLayout n'a plus à les passer en props.
import NavBar from './NavBar.astro'
import TopBanner from './TopBanner.astro'
import { getNavigation } from '@/services/navigation'

const nav = await getNavigation()
---

<header class='site-header'>
  <TopBanner
    title={nav.bannerText}
    text={nav.bannerLinkLabel}
    href={nav.bannerLinkHref}
  />
  <NavBar />
</header>
