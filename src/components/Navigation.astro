---
import { getNavigation } from '@/services/navigation'

const { mainLinks } = await getNavigation()
const currentPath = Astro.url.pathname
---

<ul
  class='nav__menu'
  id='nav-menu'
>
  {
    mainLinks.map(({ href, label }) => (
      <li class='nav__item'>
        <a
          href={href}
          class:list={[
            'nav__link',
            {
              'nav__link--active': href === '/' ? currentPath === '/' : currentPath.startsWith(href.replace(/\/$/, '')),
            },
          ]}
        >
          {label}
        </a>
      </li>
    ))
  }
</ul>
