---
import Logo from './Logo.astro'
import { getNavigation } from '@/services/navigation'
import { getUiLabels } from '@/services/ui-labels'

const nav = await getNavigation()
const labels = await getUiLabels()
const year = new Date().getFullYear()
---

<footer class='site-footer'>
  <div class='site-footer__inner'>
    <!-- Colonne marque & contact -->
    <div class='site-footer__brand'>
      <Logo class='site-footer__logo' />

      <address class='site-footer__contact'>
        <a
          href={`mailto:${nav.contactEmail}`}
          class='site-footer__contact-link'
        >
          <span
            class='icon icon--mail site-footer__contact-icon'
            aria-hidden='true'
          ></span>
          {nav.contactEmail}
        </a>
        <a
          href={`tel:${(nav.contactPhone ?? '').replace(/[^+0-9]/g, '')}`}
          class='site-footer__contact-link'
        >
          <span
            class='icon icon--phone site-footer__contact-icon'
            aria-hidden='true'
          ></span>
          {nav.contactPhone}
        </a>
        <span class='site-footer__contact-item'>
          <span
            class='icon icon--location site-footer__contact-icon'
            aria-hidden='true'
          ></span>
          {nav.contactAddress}
        </span>
      </address>
    </div>

    <!-- Colonnes de navigation -->
    <div class='site-footer__links'>
      {
        nav.footerSections.map((section) => (
          <nav
            class='site-footer__nav'
            aria-label={section.title}
          >
            <p class='site-footer__nav-title'>{section.title}</p>
            <ul class='site-footer__nav-list'>
              {section.links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    class='site-footer__nav-link'
                    target={link.external ? '_blank' : undefined}
                    rel={link.external ? 'noopener noreferrer' : undefined}
                  >
                    {link.label}
                    {link.external && <span class='sr-only'> {labels.externalLinkSuffix}</span>}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }

      <div class='site-footer__nav'>
        <p class='site-footer__nav-title'>{nav.socialTitle}</p>
        <ul class='site-footer__social-list'>
          {
            nav.socialLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  class='site-footer__social-link'
                  aria-label={link.label}
                >
                  <span
                    class:list={['icon', `icon--${link.icon}`, 'site-footer__social-icon']}
                    aria-hidden='true'
                  />
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>

  <hr class='site-footer__divider' />

  <div class='site-footer__bottom'>
    <p class='site-footer__copyright'>© {year} LP DWCA — Université de Strasbourg. {nav.copyright}</p>

    <nav
      class='site-footer__legal'
      aria-label='Informations légales'
    >
      <ul class='site-footer__legal-list'>
        {
          nav.legalLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class='site-footer__legal-link'
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</footer>
