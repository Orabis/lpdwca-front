---
import Button from '@/components/ui/Button.astro'
import { getHomeContent } from '@/services/home'
import heroImage from '@/assets/images/woman-programming-3597101.jpg'
import heroLogosDesktop from '@/assets/images/home/logos/hero-logos-desktop.png'
import heroLogosMobile from '@/assets/images/home/logos/hero-logos-mobile.png'

const { hero, partnersTitle } = await getHomeContent()
---

<section
  class='home-hero'
  aria-labelledby='home-hero-title'
>
  <div class='home-hero__inner'>
    <h1
      class='home-hero__title'
      id='home-hero-title'
    >
      <span class='home-hero__title-accent'>{hero.accentWord}</span> {hero.title}
    </h1>
    <p class='home-hero__text'>{hero.text}</p>
    <p class='home-hero__subtext'>{hero.subtext}</p>

    <div class='home-hero__actions'>
      <Button href={hero.ctaPrimaryHref}>{hero.ctaPrimaryLabel}</Button>
      <Button
        href={hero.ctaSecondaryHref}
        variant='outline'
        >{hero.ctaSecondaryLabel}</Button
      >
    </div>

    <div
      class='home-hero__logos'
      aria-label={partnersTitle ?? 'Logos de partenaires'}
    >
      <img
        class='home-hero__logos-image home-hero__logos-image--desktop'
        src={heroLogosDesktop.src}
        width='2580'
        height='270'
        alt={hero.logosAlt}
      />
      <img
        class='home-hero__logos-image home-hero__logos-image--mobile'
        src={heroLogosMobile.src}
        width='1130'
        height='450'
        alt={hero.logosAlt}
      />
    </div>

    <div
      class='home-hero__visual'
      aria-hidden='true'
    >
      <img
        class='home-hero__image'
        src={heroImage.src}
        width='1280'
        height='429'
        alt=''
      />
      <button
        class='home-hero__play'
        type='button'
        tabindex='-1'
        aria-label='Lire la présentation'
      >
        <span class='home-hero__play-icon'></span>
      </button>
    </div>
  </div>
</section>
