---
import Button from '@/components/ui/Button.astro'
import { getHomeContent } from '@/services/home'
import heroImage from '@/assets/images/woman-programming-3597101.jpg'
import logoUnistra from '@/assets/images/home/logos/unistra.svg'
import logoSolutyo from '@/assets/images/home/logos/solutyo.png'
import logoTokTokDoc from '@/assets/images/home/logos/toktokdoc.svg'
import logoAdvisa from '@/assets/images/home/logos/advisa.svg'
import logoAlsaceDigitale from '@/assets/images/home/logos/alsace-digitale.png'

const { hero, partnersTitle } = await getHomeContent()

// Structures d'accueil des alternants et stagiaires. Les visuels restent servis
// par le depot, comme les portraits des responsables, tant qu'ils ne sont pas
// televerses dans Strapi.
const partenaires = [
  { nom: 'Université de Strasbourg', logo: logoUnistra },
  { nom: 'Solutyo', logo: logoSolutyo },
  { nom: 'TokTokDoc', logo: logoTokTokDoc },
  { nom: 'Advisa', logo: logoAdvisa },
  { nom: 'Alsace Digitale', logo: logoAlsaceDigitale },
]
---

<section
  class='home-hero'
  aria-labelledby='home-hero-title'
>
  <div class='home-hero__inner'>
    <h1
      class='home-hero__title'
      id='home-hero-title'
    >
      <span class='home-hero__title-accent'>{hero.accentWord}</span> {hero.title}
    </h1>
    <p class='home-hero__text'>{hero.text}</p>
    <p class='home-hero__subtext'>{hero.subtext}</p>

    <div class='home-hero__actions'>
      <Button href={hero.ctaPrimaryHref}>{hero.ctaPrimaryLabel}</Button>
      <Button
        href={hero.ctaSecondaryHref}
        variant='outline'
        >{hero.ctaSecondaryLabel}</Button
      >
    </div>

    <div
      class='home-hero__logos'
      aria-label={partnersTitle ?? 'Structures d’accueil'}
    >
      <ul class='home-hero__logos-list'>
        {
          partenaires.map((partenaire) => (
            <li class='home-hero__logos-item'>
              <img
                class='home-hero__logo'
                src={partenaire.logo.src}
                alt={partenaire.nom}
                loading='lazy'
              />
            </li>
          ))
        }
      </ul>
    </div>

    <div
      class='home-hero__visual'
      aria-hidden='true'
    >
      <img
        class='home-hero__image'
        src={heroImage.src}
        width='1280'
        height='429'
        alt=''
      />
      <button
        class='home-hero__play'
        type='button'
        tabindex='-1'
        aria-label='Lire la présentation'
      >
        <span class='home-hero__play-icon'></span>
      </button>
    </div>
  </div>
</section>
