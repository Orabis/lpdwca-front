---
interface Props {
  title: string
  icon: string
  intro?: string
  items?: string[]
  ordered?: boolean
}

const { title, icon, intro, items = [], ordered = false } = Astro.props
const ListTag = ordered ? 'ol' : 'ul'
---

<article class='info-card'>
  <span
    class='info-card__icon-box'
    aria-hidden='true'
  >
    <span class:list={['icon', `icon--${icon}`, 'info-card__icon']}></span>
  </span>
  <h3 class='info-card__title'>{title}</h3>
  {intro && <p class='info-card__intro'>{intro}</p>}
  {
    items.length > 0 && (
      <ListTag class:list={['info-card__list', { 'info-card__list--ordered': ordered }]}>
        {items.map((item) => (
          <li>{item}</li>
        ))}
      </ListTag>
    )
  }
</article>
