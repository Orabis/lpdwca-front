---
import type { ImageMetadata } from 'astro'

interface Props {
  name: string
  role: string
  imageSrc?: ImageMetadata
  imageAlt?: string
  align?: 'left' | 'right'
}

const { name, role, imageSrc, imageAlt, align } = Astro.props

// Faute de portrait fourni, on affiche le logo de la formation : jamais le
// visage d'un autre responsable.
const FALLBACK_LOGO = '/assets/Logo.png'
---

<article class:list={['lead-card', align && `lead-card--align-${align}`]}>
  {
    imageSrc ? (
      <img
        class='lead-card__photo'
        src={imageSrc.src}
        alt={imageAlt}
        width='120'
        height='120'
        loading='lazy'
      />
    ) : (
      <img
        class='lead-card__photo lead-card__photo--fallback'
        src={FALLBACK_LOGO}
        alt=''
        aria-hidden='true'
        width='120'
        height='120'
        loading='lazy'
      />
    )
  }
  <div class='lead-card__content'>
    <h3 class='lead-card__name'>{name}</h3>
    <p class='lead-card__role'>{role}</p>
  </div>
</article>
