[Unit]
Description=Récepteur de webhook LP DWCA — reconstruit le front à chaque publication Strapi
After=network.target docker.service
Requires=docker.service

[Service]
Type=simple
# Le binaire vient du paquet Debian/Ubuntu « webhook » (apt install webhook).
# -ip 127.0.0.1 : jamais exposé directement — on passe par le reverse proxy.
ExecStart=/usr/bin/webhook -hooks /opt/lpdwca-deploy/hooks.json -ip 127.0.0.1 -port 9000 -verbose
Restart=on-failure
RestartSec=5

# Le script lance des commandes docker et git : root est le plus simple sur un
# serveur personnel. Alternative : un utilisateur dédié membre du groupe docker.
User=root

[Install]
WantedBy=multi-user.target
